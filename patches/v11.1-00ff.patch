+//[EXPERIMENT U32 -> default] Storage backend selector, from SYNA_NATIVE_STORAGE:
+//  unset / 1 -> closed adapter's native WBF storage interface + OpenDatabase (DEFAULT)
+//  0         -> host-only storage.c (legacy, enroll works but identify can't match)
+//  2         -> native interface + CreateDatabase then OpenDatabase
+//For the secure 06cb:00ff match-in-sensor part, only the native storage adapter issues
+//the DeviceIoControl that links an enrolled template into sensor DB2 (the type-3 child
+//that the matcher loads). Host storage.c only updates a RAM list -> orphan template ->
+//identify always NO_RESULTS. Native is the proven-working path (UPDATE 34), so it is now
+//the default; set SYNA_NATIVE_STORAGE=0 to fall back to the legacy host backend.
+static int u32_storage_mode(void) {
+    const char *e = getenv("SYNA_NATIVE_STORAGE");
+    if(!e || !*e) return 1;   //default: native storage
+    return atoi(e);
+}
+
+//Print a hex dump, collapsing runs of >=16 identical bytes into "XX*N" so that
+//large mostly-zero IOCTL buffers don't spam the log. Losslessly reconstructable.
+static void print_hex_compressed(const uint8_t *buf, size_t size) {
+    size_t i = 0;
+    while(i < size) {
+        size_t run = 1;
+        while(i + run < size && buf[i + run] == buf[i]) run++;
+        if(run >= 16) {
+            printf("%02x*%zu ", buf[i], run);
+        } else {
+            for(size_t j = 0; j < run; j++) printf("%02x", buf[i]);
+        }
+        i += run;
+    }
+}
