diff --git a/libtudor/src/winapi/crypt/crypt.c b/libtudor/src/winapi/crypt/crypt.c
index 8e7ad0d..97caaff 100644
--- a/libtudor/src/winapi/crypt/crypt.c
+++ b/libtudor/src/winapi/crypt/crypt.c
@@ -2,10 +2,18 @@
 #include <openssl/rand.h>
 #include <openssl/evp.h>
 #include <string.h>
+#include <stdlib.h>
 #include "crypt.h"
 
 __winfnc BOOL CryptAcquireContextA(struct crypt_provider **prov, const char *cont_name, const char *prov_name, DWORD prov_type, DWORD flags) {
     switch(prov_type) {
+        /* PROV_RSA_FULL: the v11.1 driver acquires a 'SYNA' container at enroll commit
+         * to seal/bind the template. Its import tables show it only does hashing /
+         * CryptImportKey / CryptEncrypt/Decrypt / CryptGenRandom with it (NO CryptGenKey),
+         * all of which crypt_prov_rsa_aes already services — so hand back the same provider.
+         * Rejecting it (the old default) left templates unsealed -> identify/verify never
+         * match. */
+        case PROV_RSA_FULL:
         case PROV_RSA_AES: *prov = &crypt_prov_rsa_aes; return TRUE;
         default: {
             log_warn("CryptAcquireContextA | Couldn't find provider for container '%s' provider '%s' provider type 0x%x flags 0x%x", cont_name, prov_name, prov_type, flags);
@@ -15,6 +23,18 @@ __winfnc BOOL CryptAcquireContextA(struct crypt_provider **prov, const char *con
 }
 WINAPI(CryptAcquireContextA)
 
+/* v11.1 calls the wide variant during enroll commit (acquiring a crypto context to
+ * seal the template). Container/provider names are normally NULL; just widen->narrow
+ * and delegate to the A impl. */
+__winfnc BOOL CryptAcquireContextW(struct crypt_provider **prov, const char16_t *cont_name, const char16_t *prov_name, DWORD prov_type, DWORD flags) {
+    char *cont = cont_name ? winstr_to_str(cont_name) : NULL;
+    char *provn = prov_name ? winstr_to_str(prov_name) : NULL;
+    BOOL r = CryptAcquireContextA(prov, cont, provn, prov_type, flags);
+    free(cont); free(provn);
+    return r;
+}
+WINAPI(CryptAcquireContextW)
+
 __winfnc BOOL CryptReleaseContext(struct crypt_provider *prov, DWORD flags) {
     return TRUE;
 }
