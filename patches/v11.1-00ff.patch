diff --git a/libtudor/src/winapi/wdf/device.c b/libtudor/src/winapi/wdf/device.c
index ffd727a..ae27ac2 100644
--- a/libtudor/src/winapi/wdf/device.c
+++ b/libtudor/src/winapi/wdf/device.c
@@ -350,6 +350,34 @@ WDFFUNC(WdfDeviceStopIdleActual, 248)
 __winfnc void WdfDeviceResumeIdleActual(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj) {}
 WDFFUNC(WdfDeviceResumeIdleActual, 249)
 
+/* v11.1 (06cb:00ff) calls these during EvtDeviceAdd to advertise PnP/power caps
+ * (removable, surprise-removal-ok, unique-id, wake, etc). We drive the sensor over
+ * libusb with no real PnP/power stack, so they're safe no-ops. Both are VOID in the
+ * WDF DDI. 34 is pre-added: drivers set PnP+power capabilities as a pair. */
+__winfnc void WdfDeviceSetPnpCapabilities(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj, void *pnp_caps) {}
+WDFFUNC(WdfDeviceSetPnpCapabilities, 33)
+
+__winfnc void WdfDeviceSetPowerCapabilities(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj, void *power_caps) {}
+WDFFUNC(WdfDeviceSetPowerCapabilities, 34)
+
+/* v11.1 writes a metadata property onto its device interface during bring-up. We have
+ * no real device interface (libusb), nothing reads it back, so succeed without storing.
+ * Sig: (Device, PWDF_DEVICE_INTERFACE_PROPERTY_DATA, DEVPROPTYPE, ULONG len, PVOID buf). */
+__winfnc NTSTATUS WdfDeviceAssignInterfaceProperty(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj, void *prop_data, DWORD type, ULONG buf_len, void *prop_buf) { return STATUS_SUCCESS; }
+WDFFUNC(WdfDeviceAssignInterfaceProperty, 50)
+
+/* v11.1 queries an interface property (allocates a WDFMEMORY out-param). We have no
+ * property store, so report "absent" — well-behaved drivers treat this as optional and
+ * skip. Null the out-params defensively. If the driver instead round-trips its OWN
+ * property here and can't tolerate not-found, escalate to a real Assign<->Query store.
+ * Sig: (Device, PropertyData, POOL_TYPE, PWDF_OBJECT_ATTRIBUTES, WDFMEMORY* out, PDEVPROPTYPE out). */
+__winfnc NTSTATUS WdfDeviceAllocAndQueryInterfaceProperty(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj, void *prop_data, int pool_type, WDF_OBJECT_ATTRIBUTES *mem_attrs, WDFOBJECT *out_mem, DWORD *out_type) {
+    if(out_mem) *out_mem = NULL;
+    if(out_type) *out_type = 0;
+    return STATUS_NOT_FOUND;
+}
+WDFFUNC(WdfDeviceAllocAndQueryInterfaceProperty, 51)
+
 __winfnc NTSTATUS WdfDeviceCreateDeviceInterface(WDF_DRIVER_GLOBALS *globals, WDFOBJECT device_obj, const GUID *interface_guid, const UNICODE_STRING *ref_str) { return STATUS_SUCCESS; }
 WDFFUNC(WdfDeviceCreateDeviceInterface, 27)
 
