+//<<<<< Off-bus fd-passing socket >>>>>
+
+static int fdpass_listen_fd = -1;
+
+static struct host_entry *find_host(guint host_id) {
+    for(int i = 0; i < hosts_array->len; i++) {
+        struct host_entry *entry = &g_array_index(hosts_array, struct host_entry, i);
+        if(entry->id == host_id) return entry;
+    }
+    return NULL;
+}
+
+static gboolean fdpass_accept_cb(gint listen_fd, GIOCondition cond, gpointer user_data) {
+    int cfd = accept(listen_fd, NULL, NULL);
+    if(cfd < 0) {
+        if(errno != EINTR && errno != EAGAIN) g_warning("fd-pass accept() failed: %s", g_strerror(errno));
+        return G_SOURCE_CONTINUE;
+    }
+
+    //Read the requested host id (the 0600 socket perms already gate this to root peers)
+    guint host_id = 0;
+    ssize_t r = read(cfd, &host_id, sizeof(host_id));
+    if(r != (ssize_t) sizeof(host_id)) {
+        g_warning("fd-pass peer sent a malformed request");
+        g_assert_no_errno(close(cfd));
+        return G_SOURCE_CONTINUE;
+    }
+
+    struct host_entry *entry = find_host(host_id);
+
+    //Reply with a status byte, plus the host IPC fd as ancillary data on success
+    char status = entry ? 1 : 0;
+    struct iovec iov = { .iov_base = &status, .iov_len = 1 };
+    struct msghdr mh;
+    memset(&mh, 0, sizeof(mh));
+    mh.msg_iov = &iov;
+    mh.msg_iovlen = 1;
+
+    char cbuf[CMSG_SPACE(sizeof(int))];
+    if(entry) {
+        memset(cbuf, 0, sizeof(cbuf));
+        mh.msg_control = cbuf;
+        mh.msg_controllen = sizeof(cbuf);
+        struct cmsghdr *cm = CMSG_FIRSTHDR(&mh);
+        cm->cmsg_level = SOL_SOCKET;
+        cm->cmsg_type = SCM_RIGHTS;
+        cm->cmsg_len = CMSG_LEN(sizeof(int));
+        //SCM_RIGHTS dups the fd into the receiver; our own entry->pipe_fd stays valid
+        memcpy(CMSG_DATA(cm), &entry->pipe_fd, sizeof(int));
+    }
+
+    if(sendmsg(cfd, &mh, 0) < 0) g_warning("Failed to hand off host fd: %s", g_strerror(errno));
+    else if(entry) g_info("Handed host ID %u IPC fd to fd-pass peer", host_id);
+    else g_warning("fd-pass peer requested unknown host ID %u", host_id);
+
+    g_assert_no_errno(close(cfd));
+    return G_SOURCE_CONTINUE;
+}
+
+static void init_fdpass() {
+    g_assert_no_errno(fdpass_listen_fd = socket(AF_UNIX, SOCK_STREAM, 0));
+
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    g_strlcpy(addr.sun_path, TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH, sizeof(addr.sun_path));
+
+    unlink(TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH);
+    if(bind(fdpass_listen_fd, (struct sockaddr*) &addr, sizeof(addr)) < 0)
+        g_error("Failed to bind fd-pass socket '%s': %s", TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH, g_strerror(errno));
+
+    //Root-only: the launcher runs as root and so does fprintd, so 0600 keeps everyone else out
+    g_assert_no_errno(chmod(TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH, 0600));
+    g_assert_no_errno(listen(fdpass_listen_fd, 8));
+
+    g_unix_fd_add(fdpass_listen_fd, G_IO_IN, fdpass_accept_cb, NULL);
+    g_info("Listening for off-bus fd-pass requests on '%s'", TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH);
+}
+
 void init_launcher() {
     //Create hosts array
     hosts_array = g_array_new(FALSE, FALSE, sizeof(struct host_entry));
+
+    //Set up the off-bus fd-passing socket
+    init_fdpass();
 }
 
 void uninit_launcher() {
+    //Tear down the fd-passing socket
+    if(fdpass_listen_fd >= 0) {
+        g_assert_no_errno(close(fdpass_listen_fd));
+        fdpass_listen_fd = -1;
+        unlink(TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH);
+    }
+
     //Free hosts array
     g_array_unref(hosts_array);
 }
