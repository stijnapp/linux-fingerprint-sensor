+/* v11.1 (06cb:00ff) subscribes to power-SETTING change notifications (e.g. console
+ * lock, monitor power) during bring-up. No power events are delivered in the CLI
+ * context, so accept the subscription and hand back a null handle, mirroring the
+ * suspend/resume stub above. */
+__winfnc DWORD PowerSettingRegisterNotification(const GUID *setting_guid, DWORD flags, HANDLE recipient, HANDLE *out) {
+    if(out) *out = NULL;
+    return ERROR_SUCCESS;
+}
+WINAPI(PowerSettingRegisterNotification)
+
+__winfnc DWORD PowerSettingUnregisterNotification(HANDLE handle) {
+    return ERROR_SUCCESS;
+}
+WINAPI(PowerSettingUnregisterNotification)
