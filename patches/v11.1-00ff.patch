+/* Plaintext peek of the TLS record payload (= VCSFW command/response frame).
+ * This is the ONLY place the cleartext firmware-command stream is visible:
+ * the closed driver TLS-wraps every command via these BCrypt GCM calls before
+ * handing ciphertext to WdfUsbPipeWrite, so the [DEVCTRL] log (FpAdapter->USB
+ * IOCTL boundary) never sees commands the driver issues internally at
+ * OnPrepareHardware / OnD0Entry (e.g. the DB2 GET_DB_INFO/GET_OBJECT_LIST ->
+ * RetrieveTemplatesFromFlash -> OnSetTemplateList matcher-load chain). */
+/* VCSFW opcode -> name. byte[0] of an outbound (TX) command frame. 9e/9f/a0/a1
+ * confirmed on the wire; a2/a3/a4/a5 inferred from the firmware string order
+ * (WRITE/DELETE_OBJECT, FORMAT, CLEANUP) — treat a3+ as tentative. */
+static const char *vcsfw_op_name(uint8_t op) {
+    switch(op) {
+        case 0x80: return "FRAME_READ?";
+        case 0x81: return "FRAME_FINISH?";
+        case 0x82: return "GET_VERSION";
+        case 0x86: return "CAPTURE_FRAME";
+        case 0x87: return "CAPTURE_GET";
+        case 0x96: return "ENROLL";          /* 9601 create / 9602 update / 9604 commit */
+        case 0x99: return "GET_MATCH_RESULT";
+        case 0x9d: return "IDENTIFY_MATCH";
+        case 0x9e: return "DB2_GET_DB_INFO";
+        case 0x9f: return "DB2_GET_OBJECT_LIST";
+        case 0xa0: return "DB2_GET_OBJECT_INFO";
+        case 0xa1: return "DB2_GET_OBJECT_DATA";
+        case 0xa2: return "DB2_WRITE_OBJECT";
+        case 0xa3: return "DB2_DELETE_OBJECT?";
+        case 0xa4: return "DB2_FORMAT?";
+        case 0xa5: return "DB2_CLEANUP?";
+        default:   return "?";
+    }
+}
+
+/* [EXPERIMENT U28] capture the minted enrollment template GUID from the enroll
+ * response stream. On v11.1 the WBF AddRecord blob is empty (template is sensor-
+ * resident), so the only place the minted template's 16-byte GUID is visible is
+ * here on the cleartext wire. storage_AddRecord stashes it into the host record so
+ * the replayed common-prop child (type-3) record can reference the real type-2
+ * template. Globals are read by libtudor/src/tudor/storage.c. */
+uint8_t tudor_exp_enroll_tmpl_guid[16];
+bool tudor_exp_have_enroll_tmpl_guid = false;
+static uint8_t bc_last_tx_op = 0;
+
+static void bc_plaintext_peek(const char *tag, const char *algo, const uint8_t *buf, size_t size) {
+    //Cleartext VCSFW frame dump is a protocol-analysis aid: keep it OFF at the
+    //default INFO level (it would otherwise flood the journal with the cleartext
+    //command stream on every login/enroll/verify). Raise LOG_LEVEL to VERBOSE to
+    //re-enable it for reverse-engineering. The U28 guid capture in BCryptDecrypt
+    //is independent of this gate and stays active.
+    if(LOG_LEVEL > LOG_VERBOSE) return;
+    pthread_mutex_lock(&LOG_LOCK);
+    bool is_tx = tag && tag[7] == 'T'; /* "CRYPTO TX" */
+    const char *op = (is_tx && size > 0) ? vcsfw_op_name(buf[0]) : "";
+    printf("[%s] algo=%s size=0x%lx %s%s: ", tag, algo ? algo : "?",
+        (unsigned long) size, op[0] ? "op=" : "", op);
+    size_t n = size < 256 ? size : 256;
+    for(size_t i = 0; i < n; i++) printf("%02x", buf[i]);
+    if(n < size) printf("..(+0x%lx)", (unsigned long)(size - n));
+    printf("\n");
+    pthread_mutex_unlock(&LOG_LOCK);
+}
+
