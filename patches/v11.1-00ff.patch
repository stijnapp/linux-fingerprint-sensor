+//Fetch a host's IPC socket fd off the system bus, over the launcher's private fd-pass
+//socket. dbus-broker drops the launcher when it returns an fd in a DBus reply, so the
+//launcher hands the fd over this AF_UNIX channel instead (see dbus-launcher.h).
+static bool fetch_host_fd(guint host_id, int *sock_fd, GError **error) {
+    int cfd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if(cfd < 0) {
+        *error = fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "fd-pass socket() failed: %s", g_strerror(errno));
+        return false;
+    }
+
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    g_strlcpy(addr.sun_path, TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH, sizeof(addr.sun_path));
+    if(connect(cfd, (struct sockaddr*) &addr, sizeof(addr)) < 0) {
+        *error = fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "Failed to connect to host fd-pass socket '%s': %s", TUDOR_HOST_LAUNCHER_FDPASS_SOCK_PATH, g_strerror(errno));
+        close(cfd);
+        return false;
+    }
+
+    //Ask the launcher for this host's IPC fd
+    if(write(cfd, &host_id, sizeof(host_id)) != (ssize_t) sizeof(host_id)) {
+        *error = fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "Failed to request host %u fd: %s", host_id, g_strerror(errno));
+        close(cfd);
+        return false;
+    }
+
+    //Receive the status byte plus the fd as ancillary data
+    char status = 0;
+    struct iovec iov = { .iov_base = &status, .iov_len = 1 };
+    char cbuf[CMSG_SPACE(sizeof(int))];
+    struct msghdr mh;
+    memset(&mh, 0, sizeof(mh));
+    mh.msg_iov = &iov;
+    mh.msg_iovlen = 1;
+    mh.msg_control = cbuf;
+    mh.msg_controllen = sizeof(cbuf);
+    memset(cbuf, 0, sizeof(cbuf));
+
+    ssize_t r = recvmsg(cfd, &mh, 0);
+    close(cfd);
+    if(r != 1 || status != 1) {
+        *error = fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "Host fd-pass for host %u failed (recv %zd, status %d)", host_id, r, status);
+        return false;
+    }
+
+    //Extract the fd from the control message
+    for(struct cmsghdr *cm = CMSG_FIRSTHDR(&mh); cm; cm = CMSG_NXTHDR(&mh, cm)) {
+        if(cm->cmsg_level == SOL_SOCKET && cm->cmsg_type == SCM_RIGHTS) {
+            memcpy(sock_fd, CMSG_DATA(cm), sizeof(int));
+            return true;
+        }
+    }
+
+    *error = fpi_device_error_new_msg(FP_DEVICE_ERROR_GENERAL, "Host fd-pass for host %u returned no fd", host_id);
+    return false;
+}
