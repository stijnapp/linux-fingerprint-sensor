+        case 0x00090001: return "WINBIO_I_MORE_DATA";
+        case 0x80098001: return "WINBIO_E_UNSUPPORTED_FACTOR";
+        case 0x80098002: return "WINBIO_E_INVALID_UNIT";
+        case 0x80098003: return "WINBIO_E_UNKNOWN_ID";
+        case 0x80098004: return "WINBIO_E_CANCELED";
+        case 0x80098005: return "WINBIO_E_NO_MATCH";
+        case 0x80098006: return "WINBIO_E_CAPTURE_ABORTED";
+        case 0x80098007: return "WINBIO_E_ENROLLMENT_IN_PROGRESS";
+        case 0x80098008: return "WINBIO_E_BAD_CAPTURE";
+        case 0x80098009: return "WINBIO_E_INVALID_CONTROL_CODE";
+        case 0x8009800C: return "WINBIO_E_UNSUPPORTED_DATA_FORMAT";
+        case 0x8009800E: return "WINBIO_E_UNSUPPORTED_PURPOSE";
+        case 0x8009800F: return "WINBIO_E_INVALID_DEVICE_STATE";
+        case 0x80098010: return "WINBIO_E_DEVICE_BUSY";
+        case 0x80098011: return "WINBIO_E_DATABASE_CANT_CREATE";
+        case 0x80098012: return "WINBIO_E_DATABASE_CANT_OPEN";
+        case 0x80098015: return "WINBIO_E_DATABASE_CANT_FIND";
+        case 0x80098016: return "WINBIO_E_DATABASE_ALREADY_EXISTS";
+        case 0x80098018: return "WINBIO_E_DATABASE_FULL";
+        case 0x80098019: return "WINBIO_E_DATABASE_LOCKED";
+        case 0x8009801A: return "WINBIO_E_DATABASE_CORRUPTED";
+        case 0x8009801B: return "WINBIO_E_DATABASE_NO_SUCH_RECORD";
+        case 0x8009801C: return "WINBIO_E_DUPLICATE_ENROLLMENT";
+        case 0x8009801D: return "WINBIO_E_DATABASE_READ_ERROR";
+        case 0x8009801E: return "WINBIO_E_DATABASE_WRITE_ERROR";
+        case 0x8009801F: return "WINBIO_E_DATABASE_NO_RESULTS";
+        case 0x80098020: return "WINBIO_E_DATABASE_NO_MORE_RECORDS";
+        case 0x80098026: return "WINBIO_E_NO_CAPTURE_DATA";
